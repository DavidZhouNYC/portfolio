---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';

const experience = await getCollection('experience');
const projects = await getCollection('projects');

const sortedExperience = experience.sort((a, b) =>
  new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
---

<Base title="David Zhou | Software Engineer">
  <Nav />

  <main class="pt-16">
    <!-- Hero Section -->
    <section class="min-h-[80vh] flex items-center justify-center px-6">
      <div class="max-w-3xl mx-auto text-center">
        <h1 class="text-5xl md:text-7xl font-bold mb-4 tracking-tight">
          David Zhou
        </h1>
        <p class="text-2xl md:text-3xl text-white/70 mb-8 font-mono">
          Software Engineer
        </p>
        <p class="text-lg text-white/60 mb-12 max-w-xl mx-auto">
          Software Engineer with 5+ years of experience building scalable,
          accessible web applications in Agile/Scrum environments.
          Specializes in frontend development using React, TypeScript, JavaScript,
          HTML, CSS, and TailwindCSS, with full-stack experience using Node.js,
          RESTful APIs, databases, and CMS platforms.
        </p>
        <div class="flex items-center justify-center gap-4">
          <a
            href="/about"
            class="px-6 py-3 bg-accent text-white rounded-lg font-medium hover:bg-accent/80 transition-colors"
          >
            About Me
          </a>
          <a
            href="/projects"
            class="px-6 py-3 border border-white/20 text-white rounded-lg font-medium hover:bg-white/5 transition-colors"
          >
            View Projects
          </a>
        </div>
      </div>
    </section>

    <!-- Quick Resume Section -->
    <section class="py-20 px-6 bg-white/5">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-3xl font-bold mb-12 text-center">Experience</h2>
        <div class="space-y-8">
          {sortedExperience.map((job) => (
            <div class="border-l-2 border-accent pl-6">
              <div class="flex items-start justify-between flex-wrap gap-2">
                <div>
                  <h3 class="text-xl font-semibold">{job.data.title}</h3>
                  <p class="text-accent font-medium">{job.data.company}</p>
                </div>
                <span class="text-white/50 text-sm">{job.data.range}</span>
              </div>
              <p class="text-white/60 mt-2">{job.data.location}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Projects Preview -->
    <section class="py-20 px-6">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-3xl font-bold mb-12 text-center">Featured Projects</h2>
        <div class="grid md:grid-cols-2 gap-6">
          {projects.slice(0, 2).map((project) => (
            <div class="border border-white/10 rounded-lg p-6 hover:border-accent/50 transition-colors">
              <h3 class="text-xl font-semibold mb-2">{project.data.title}</h3>
              <p class="text-white/60 mb-4 line-clamp-2">{project.data.description}</p>
              <div class="flex flex-wrap gap-2 mb-4">
                {project.data.technologies.map((tech) => (
                  <span class="px-2 py-1 bg-white/5 text-white/70 text-xs rounded">
                    {tech}
                  </span>
                ))}
              </div>
              <div class="flex gap-4">
                {project.data.links.github && (
                  <a
                    href={project.data.links.github}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-accent hover:text-accent/80 text-sm font-medium"
                  >
                    GitHub &rarr;
                  </a>
                )}
                {project.data.links.website && (
                  <a
                    href={project.data.links.website}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-accent hover:text-accent/80 text-sm font-medium"
                  >
                    Live Demo &rarr;
                  </a>
                )}
              </div>
            </div>
          ))}
        </div>
        <div class="text-center mt-10">
          <a href="/projects" class="text-accent hover:text-accent/80 font-medium">
            View All Projects &rarr;
          </a>
        </div>
      </div>
    </section>

    <!-- Contact CTA -->
    <section class="py-20 px-6 bg-white/5 text-center">
      <div class="max-w-2xl mx-auto">
        <h2 class="text-3xl font-bold mb-4">Get In Touch</h2>
        <p class="text-white/60 mb-8">
          Interested in working together? Feel free to reach out.
        </p>
        <a
          href="/contact"
          class="inline-block px-8 py-3 bg-accent text-white rounded-lg font-medium hover:bg-accent/80 transition-colors"
        >
          Contact Me
        </a>
      </div>
    </section>
  </main>

  <Footer />
</Base>
