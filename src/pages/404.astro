---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<Base title="404 - Page Not Found | David Zhou">
  <Nav />

  <main class="min-h-[70vh] flex items-center justify-center px-6">
    <div class="text-center">
      <div class="text-8xl font-bold text-white/10 mb-4">404</div>
      <h1 class="text-3xl font-bold mb-4">Page Not Found</h1>
      <p class="text-white/60 mb-8">
        The page you are looking for does not exist.
      </p>
      <a
        href="/"
        class="inline-block px-6 py-3 bg-accent text-white rounded-lg font-medium hover:bg-accent/80 transition-colors"
      >
        Go Home
      </a>
    </div>
  </main>

  <Footer />
</Base>
